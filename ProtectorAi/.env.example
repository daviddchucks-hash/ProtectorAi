# ============================================================
# Beast AI v1 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
# Download your service account JSON from Firebase Console →
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# CORS — comma-separated list of allowed origins
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Dashboard auth (simple token — replace with a strong random string)
DASHBOARD_TOKEN=change-me-to-a-strong-secret

# Render deployment URL (set this after deploying to Render)
RENDER_URL=https://your-app.onrender.com
